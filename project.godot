; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Ocean with stars"
config/name_localized={
"ru": "Океан между звёзд"
}
run/main_scene="res://scenes/Menu/menu_lobby.tscn"
config/features=PackedStringArray("4.3", "C#", "Mobile")
boot_splash/image="res://images/Shattered-Moon.png"
config/icon="res://images/Shattered-Moon.png"
config/windows_native_icon="res://images/Shattered-Moon.ico"

[audio]

buses/default_bus_layout="res://visuals/default_bus_layout.tres"

[autoload]

BgMusic="*res://scenes/another/bg_music.tscn"
DoorsManager="*res://scripts/another/doors/doors_manager.gd"
TransScreen="*res://scenes/another/trans_screen.tscn"

[display]

window/stretch/mode="viewport"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Ocean with stars"

[file_customization]

folder_colors={
"res://resources/": "gray",
"res://resources/theme/": "teal",
"res://scenes/": "red",
"res://scripts/": "orange",
"res://sprites/": "yellow",
"res://visuals/": "green"
}

[gui]

theme/custom_font="res://resources/theme/MyHandwriting.ttf"

